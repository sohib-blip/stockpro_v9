# Identite de l'environnement : development, staging ou production
NEXT_PUBLIC_APP_ENV=development
# Adresse publique de cet environnement, utilisee pour les liens d'invitation
# envoyes par email. S'il manque : l'adresse de la requete est utilisee.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Utiliser uniquement un projet ou une branche Supabase de test en local
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-test-service-role-key

# Secrets dedies, differents par environnement (generer avec : openssl rand -base64 48)
# Signature des apercus Dispatch Planning (valables 1 heure). En le changeant,
# un apercu en cours doit etre rafraichi. S'il manque : la cle service_role est utilisee.
DISPATCH_PREVIEW_SECRET=replace-with-a-random-test-secret
# Empreinte des compteurs de quotas. En le changeant, les compteurs repartent
# de zero pour une minute au plus. S'il manque : la cle service_role est utilisee.
WORKLOAD_BUDGET_HASH_SECRET=replace-with-a-random-test-secret

# Les alertes doivent rester desactivees hors production
ENABLE_LOW_STOCK_EMAILS=false
RESEND_API_KEY=
CRON_SECRET=replace-with-a-random-test-secret
